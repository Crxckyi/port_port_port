{
  "model": "claude-opus-4-8",
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "allow": [
      "Bash(cargo test --workspace --locked *)",
      "Bash(cargo check --workspace --all-targets --locked *)",
      "Bash(cargo clippy --workspace --all-targets --locked *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
